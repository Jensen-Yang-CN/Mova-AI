# ============================================================
# Mova-AI 环境变量模板
#
# 用法：复制为同目录下的 .env 并填入真实值
#     Copy-Item .env.example .env        # PowerShell
#     cp .env.example .env               # Bash
#
# .env 已在 .gitignore 中，不会被提交。切勿把真实 Key 写进源码或示例文件。
# ============================================================

# ---------- 厂商选择：dashscope | deepseek | 其他 OpenAI 兼容端点 ----------
MOVA_PROVIDER=dashscope

# ---------- API Key ----------
# dashscope 用 DASHSCOPE_API_KEY，deepseek 用 DEEPSEEK_API_KEY，
# 也可以统一用 MOVA_API_KEY（优先级最高，方便切换厂商时少改一行）
DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# MOVA_API_KEY=

# ---------- 模型（留空则用所选厂商的默认值） ----------
# MOVA_LLM_MODEL=qwen3-max
# MOVA_VISION_MODEL=qwen-vl-max

# ---------- 自定义 OpenAI 兼容端点（自建 vLLM / SGLang 时使用） ----------
# MOVA_BASE_URL=http://127.0.0.1:8001/v1

# ---------- 服务行为 ----------
# MOVA_TIMEOUT=60            # 单次模型调用超时（秒）
# MOVA_MAX_RETRIES=2         # 可重试错误的重试次数（指数退避）
# MOVA_MAX_UPLOAD_MB=12      # 上传体积上限
# MOVA_MAX_PDF_PAGES=3       # PDF 只解析前几页
