<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ 权限 ============ -->
    <!-- 云端能力调用（教师模型 / 端云路由的云侧） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网络状态：无网时自动降级到端侧模型，需要感知连通性 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 拍照识别食材 / 读物 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 主动提醒（场景触发链路） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".MovaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MovaAI"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.MovaAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              分享入口：在微信里长按对方的消息 → 分享 → 选择 Mova-AI，
              内容作为 EXTRA_TEXT 送进来，App 直接给出回复建议。

              这是刻意选择的接入方式。另一条路是 AccessibilityService 读屏，
              它确实能"自动感知你正在用微信"、不需要手动分享，但代价是：
                ① 微信服务协议明确禁止自动化读取，账号可能被限制
                ② Android 13+ 对侧载应用默认禁止开启无障碍，需先手动允许"受限设置"
                ③ 读屏读到的是**对方**发来的消息，上传云端涉及第三方个人信息合规
              分享入口由用户主动发起，合规、可靠，且不受微信改版影响。

              launchMode=singleTask：分享时复用已有实例（走 onNewIntent），
              避免每分享一次就叠一层 Activity。
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 全分辨率拍照输出（避免系统相机只回传缩略图） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
